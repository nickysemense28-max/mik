ce":"Notice","enjoy_benefit_once":"New app users can only enjoy either the coupon bundle or the exclusive deal once.","get-now":"Get Now","save_big":"Save Big","origin_amount":{"about_amount":"About {{amount}}","orders":"Order <span>{{minAmount}}+</span>"},"error_mes":"Please fill in the required fields before submitting","apple_rule":"Apple is not a sponsor.","search":"Search","sale":"SALE","promotion_tip":"By clicking the button, you agree to the Promotion <span>Rules</span>","new_app_users_only_short":"New App Users Only","kol-cps-coupon-dnlp":{"no_benefit_sub_title":"Shop anywhere with our App"},"safe_bar":{"free_shipping":"Free shipping","within_30_days":"Price adjustment within 30 days"},"browser-task":{"no_threshold":"No threshold"},"affiliate_rule_desc_text_eu":"Obtain {{amount}} Cash or Temu credits by (i) joining affiliate program for the first time; (ii) affiliate registration is approved. Withdraw cash via Paypal or other available methods shown on the affiliate program page, or get Temu credits of equal value. Temu Credits cannot be redeemed for cash.","off_modal":{"today_limited_time_Upgrade":"Hit by amazing offer! Coupon Epic Upgrade","current_off":"Now {{percent}}% OFF!","no_minimum_needed":"Now No Minimum Needed!"},"code_rule_desc_text_eu":"Download Temu app and claim the coupon with the coupon code. The coupon is for one order only and cannot be combined with other offers. Order value over {{orderMinAmount}} is required. Discount applies to an amount up to {{amount}}.  Valid for 24h after activating the code.","native_free_gift_guide":{"exciting_news":"Exciting news","extra_gift_to_claim":"Extra <span>{{gift}}</span> to claim!","incredible_offer!":"Incredible offer!","item_you_added":"Get Item you added for {{price}}!","item_you_viewed":"Get Item you viewed for {{price}}!","qualifying_order":"*with qualifying order","viewed":"Viewed","in_cart":"In cart","claim_your_gifts":"Claim your {{free}} gifts"},"code_rule_desc_text_v3":"New App users only. Download Temu app and claim the coupon with the coupon code. The coupon applies to a single order only within the applicable product scope (if any) and cannot be combined with other offers. Order value over {{orderMinAmount}} is required. The discount is capped at {{amount}}. The coupon will expire at {{expireTime}} (local time) on the day after activating the code. <span>T&Cs apply.</span>","affiliate_rule_desc_text_v3":"You are entitled to receive a {{amount}} reward if (i) you join the Affiliate Program for the first time; and (ii) your Facebook group is reviewed and approved by Temu. The reward will be issued to your available balance and cannot be withdrawn unless your total earnings in the available balance exceed {{withdrawCash}}. You may withdraw the reward as cash via PayPal or other available methods displayed on the Affiliate Program page, or redeem it as Temu Credits. Temu Credits cannot be redeemed for cash. Check the details on the program page and Temu Affiliate Policy.","affiliate":{"left":"<Prefix>left</Prefix><TimePicker />","off":"OFF","auto_jump_app_timer":"({{time}}s)","sign_in_to_claim_countdown":"Sign in to Claim<time>({{sec}}s)</time>","get_and_use_now_countdown":"Get & use now <time>({{sec}}s)</time>"},"cps-retain-popup":{"dont-miss-best-prize":"Don’t let the benefit get away!","dont-miss-coupon":"Don’t let the coupon bundle get away!","give-up":"Give Up","shop-now":"Shop Now","save-now":"Save Now","sign-in-to-claim":"Sign in to Claim","expire-in":"<Prefix>Expire in</Prefix><TimePicker />","cart-can-save":"Your cart is eligible to <span> Save {{money}}</span>","pick-more-to-save":"Pick {{amount}} more to <span> Save {{money}}</span>"},"noChannelGoodsQAReasn":{"CART_EXIST_GOODS":"One Shopping cart can only add one item with the 'Exclusive Deal' price. You can still add it at a discounted price.","NO_CHANNEL_PRICE":"Sorry, Items at Exclusive Deal prices are sold out. You can still buy it at a discounted price.","USER_NO_QA":"Only new App users can purchase 'Exclusive Deal' products. You can still buy it at a discounted price.","GOODS_SOLD_OUT":"Sorry, Items at Exclusive Deal prices are sold out. You can still buy it at a discounted price."},"channel-goods-v2":{"limit-title":"Only new app user can purchase<bold></bold>","native-limit-title":"A new App user can only purchase <bold>one Exclusive Deal item</bold>","flash-sale":"Exclusive Deal","best_price":"Best Price","off":"<bold>{{discount}}</bold>%OFF","off-two":"-{{discount}}%","selling-fast":"Selling fast","download-dialog-title":"Download Temu app to get your exclusive best price!","get-now":"Get Now","limit-toast":"A new App user can only purchase one Exclusive Deal item","limit-toast-two":"Sorry,only new App users can purchase 'Exclusive Deal' products.","reason":"Only new app users can purchase 'Exclusive Deal' products. But you can still buy it at a discounted price."}},"affiliate_rule_short":{"download_app_claim_coupon_off_eea":"Download Temu app via this ad and claim a {{amount}} coupon bundle and a {{discount}} off coupon in the app within {{hours}} hours of downloading the Temu app for the first time.","discount_coupon_item_v2_eea":"The {{discount}} off coupon is applicable to an order over {{minAmount}}, and capped at {{maxAmount}}","coupon_bundle_includes_v1":"The {{amount}} coupon bundle includes multiple coupons: {{coupons}}.","find_more_rules_coupons_offers_qa":"Find more rules regarding Temu Coupons in \"Coupons & Offers\"  →  \"Q&A.\"","see_official_rules":"See official rules<Icon />","coupon_bundle_sum_total_value":"The total value of the coupon bundle as displayed is the sum of the potential savings you can realize if you use all of the Temu Coupons in this coupon bundle.","offer_available_once_per_user":"This offer is available once per user.","coupon_item_v1":"This is a {{amount}} off coupon, applicable to an order over {{minAmount}}.","coupons_valid_hours":"Coupons are valid for {{hours}} hours after receipt.","coupon_item_valid_hours":"The coupon is valid for {{hours}} hours after receipt.","t_c_apply":"T&Cs apply.","only_one_coupon_per_order_v2":"Only one coupon can be used per order unless otherwise stated.","coupon_cannot_be_combined":"Coupons from the {{amount}} coupon bundle cannot be combined with other coupons in the coupon bundle.","download_app_claim_coupon":"Download Temu app via this ad and claim a {{amount}} coupon bundle in the app within {{hours}} hours of downloading the Temu app for the first time.","discount_coupon_item":"The {{discount}} off coupon is applicable to an order over {{minAmount}}, and capped at {{maxAmount}}.","coupon_item_v3":"{{couponCount}} * {{amount}} off on orders over {{minAmount}}","only_claim_once":"New app users only. Each participant may only claim once.","coupon_off_rules_common":"The {{amount}} coupon bundle includes: <Coupons />. Each coupon can be used once and expires {{days}} day(s) from receipt.","coupons_applied_conditions":"Coupons can be applied to your future orders that meet the terms and conditions (e.g., threshold) shown on the coupons to reduce the payment amount.","download_app_claim_coupon_off_ko":"New App users only. Download and register for the Temu app via this ad and claim a {{amount}} coupon bundle and a {{discount}} off coupon in the app within {{hours}} hours of downloading the Temu app for the first time.","search_code_in_temu_app":"You need to search {{code}} in the Temu app at Coupons&offer or Checkout page to get the {{discount}} off coupon on an order.","download_app_claim_coupon_ko":"New App users only. Download and register for the Temu app via this ad and claim a {{amount}} coupon bundle in the app within {{hours}} hours of downloading the Temu app for the first time.","activity_requirements":"Shipping fees may apply. To qualify as an eligible New App User for this activity, you must be an individual meeting ALL of these requirements: 1)You download the Temu app and log in with your Temu account on your device. 2)You activate this activity within {{hours}} hours of the device's first downloading. 3)You haven't made any purchases on Temu before.","only_one_coupon_per_order":"Only one coupon can be used per order.","benefit_tips_rule":"This interface is for illustrative purpose only, everyone will get the best result.","coupon_rules_popup_part_pc":"*For illustrative purpose only. Obtain {{amount}} coupon bundle by (1) scanning the QR code or accessing this page via your mobile browser. (2) downloading the Temu application through the provided affiliate link or QR code. This offer is for new app users only.","coupon_bundle_rules":{"coupon_item":"{{amount}} for a min. order {{minAmount}}","coupon_item_v2":"{{couponCount}} × {{amount}} for a min. order {{minAmount}}","coupon_rules_part1":"*For illustrative purpose only. Obtain {{amount}} coupon bundle by (i) scratch the card, (ii) downloading the Temu app through the affiliate link. ","coupon_rules_part2":"*Download the app through the affiliate link and get {{amount}} coupon bundle. ","coupon_rules_common":"The coupon bundle includes the following coupons: <Coupons />. All are valid for {{days}} day(s) from receipt. ","coupon_rules_tc_part1":"Obtain {{amount}} coupon bundle by (i) scratch the card, (ii) downloading the Temu app through the affiliate link. This offer is for new app user only.","coupon_rules_tc_part2":"The coupon bundle for new app users includes the following coupons: {{couponsTips}}. The coupon bundles is valid for {{days}} day(s) from receipt. A coupon bundle is limited to one user. One coupon can be used for one order. Coupons cannot be combined.","see_detail_rules":"See detailed rules.<Icon />"},"origin_currency_rule":{"rules":"Rules","coupon_rule_v1":"<strong>Explanation of displayed value</strong></br><p>The coupon's value is in {{originCurrency}} and can be used for {{originAmount}} off orders over {{originMinAmount}}. {{amount}} and {{minAmount}} are converted based on the {{originCurrency}} to {{currency}} exchange rate.</p><p>Due to changes in the exchange rate happening in real time, the {{currency}} amounts are for reference only.</p>","coupon_rule_v2":"<strong>Explanation of displayed value</strong></br><p>The coupon bundle's value is in {{originCurrency}} and the total value is {{originAmount}} and can be used on qualified orders. {{amount}} is converted based on the {{originCurrency}} to {{currency}} exchange rate. </p><p>Due to changes in the exchange rate happening in real time, the {{currency}} amount is for reference only.</p>","coupon_rule_v3":"The coupon bundle's value is in {{originCurrency}} and the total value is {{originAmount}} and can be used on qualified orders. {{amount}} is converted based on the {{originCurrency}} to {{currency}} exchange rate. Due to changes in the exchange rate happening in real time, the {{currency}} amount is for reference only."}},"n5":{"hot_trends_selling_fast":"Hot Trends Selling Fast","crowdfavorite":"Crowd Favorite","homepage_discover_more_explore":"Explore <bold>10M+</bold> Products","homepage_discover_more_picks":"More picks on homepage","explore_more":"Explore More","homepage_discover_more_view_now":"View now","cart_push_title":"Check estimated savings in your cart","cart_push_estimated":"Estimated","join_the_crowd":"Join the Crowd","save_now":"Save Now","hot_picks_selling_fast":"Hot Picks Selling Fast","close":"Close","curve_and_plus":"Curve & Plus","best_price_guarantee":"Best Price Guarantee","homepage_discover_more_title":"Didn't find what you like? Discover more on Home.","fresh_picks_just_dropped":"Fresh Picks Just Dropped!","found_better_picks_for_you_v2":"Found Better Picks for You!","new_surprises_unlocked_v2":"New Surprises Unlocked!","temu_covers_percent_of_import_charges_trans":"<line1>Temu covers</line1><line2>{{percent}} of import charges</line2>","explore_now_trans":"Explore Now <CountDown />","reduction_applied_expires_in_time":"<line><bold>{{diffPrice}}</bold> applied,</line><line>expires in <countdown /