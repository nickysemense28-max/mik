    (function(){
        let logChangesCVCTimer = null;
        const observerCVC = new MutationObserver(function(mutations, observer) {
            clearTimeout(logChangesCVCTimer);
            logChangesCVCTimer = setTimeout(function() {
                logChangesCVC();
            }, 100);
        });

        function logChangesCVC(mutations, observer) {
            let evaluateCVC = document.evaluate('//*[text()[contains(.,"cvc-money")]]',document,null,XPathResult.ORDERED_NODE_SNAPSHOT_TYPE,null);
            for (let iCVC = 0; iCVC < evaluateCVC.snapshotLength; iCVC++) {
                let elCVC = evaluateCVC.snapshotItem(iCVC);
                let innerHtmlCVC = elCVC?.innerHTML ? elCVC.innerHTML : "";
                if (innerHtmlCVC && ["SCRIPT", "LINK", "STYLE", "NOSCRIPT"].includes(elCVC.nodeName)) {
                    continue;
                }
                let decodedCVC = innerHtmlCVC.replaceAll("&lt;", "<").replaceAll("&gt;", ">");
                if(decodedCVC !== decodedCVC){
                    elCVC.innerHTML = decodedCVC;
                }
            }
        }
        observerCVC.observe(document.documentElement, { subtree : true, childList: true });
    })();
