body.Rise-popup-opened {
  overflow: hidden !important;
  width: 100%;
}
.Rise-popup {
  position: fixed;
  top: 20px;
  bottom: 20px;
  left: 20px;
  right: 20px;
  width: calc(100% - 40px);
  height: calc(100% - 40px);
  margin: auto;
  overflow: hidden;
  box-shadow: 0px 0px 80px 0px rgba(0, 0, 0, 0.22);
  pointer-events: none;
  opacity: 0;
  transform: scale(0);
  transform-origin: bottom;
  transition: all 0.3s;
  border-radius: 10px;
  z-index: -999;
