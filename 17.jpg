  <script>
    window.loadCamWearFn = function(sku,cssClass,isAvailable,variantId) {
      
     loadTryOnButton({
        psku: sku,
        page: 'product',
        company: 'karatworld',
        regionId: 0,
        prependButton: {class: cssClass},
        MBappendButton: {class: cssClass},
        styles: {tryonbutton:{backgroundColor:'white',color:'#000000',border:'1px solid #000000',borderRadius:'0px', margin:'10px 10px', 
                              right:'0px', position:'absolute', zIndex:'2', width:'150px'},tryonbuttonHover:{backgroundColor:'#000000',color:'white',border:'none'},
        MBtryonbutton: {width:'148px', margin:'0px 35%', position:'relative'}},
        tryonButtonData:{text:'Virtual Try On',faIcon:'fa fa-camera'},
        buynow:{enable: 'true', searchProduct:'true'},
      }); 
    }
    let quickViewObserver = new MutationObserver((entries) => {
      entries.forEach(entry => {
        if(entry.target.classList.contains('screen-layer--is-active')) {
          console.log("screen layer active");
          if(!entry.target.querySelector('[id="tryonButton"]')) {
            let productJSON = JSON.parse(entry.target.querySelector(`[data-product-json="${entry.target.dataset.productId}"]`).textContent);
            window.loadCamWearFn(productJSON.variants[0].sku,`tryon-class-${productJSON.id}`,productJSON.available,productJSON.variants[0].id);
          }else{
            document.getElementById("tryonButton").style.right = "40%";
            document.getElementById("tryonButton").style.top = "10%";
          }
          entry.target.querySelector('.js-screen-close').addEventListener('click',() => {
            let productJSON = JSON.parse(entry.target.querySelector(`[data-product-json="${entry.target.dataset.productId}"]`).textContent);
           // window.loadCamWearFn(productJSON.variants[0].sku,`tryon-card-${productJSON.id}`,productJSON.available,productJSON.variants[0].id);
          });
          
        }
      });
    })
    quickViewObserver.observe(document.querySelector('#ProductScreens'),{childList: true, subtree: true, attributes: true})
  </script>    
    
