    :host {
      --spacing-size: 25px;
      --spacing-size-y: 35px;
      --spacing-size-x: 30px;
      --app-embed-padding-x: var(--spacing-size);
      --app-embed-padding-y: var(--spacing-size);
      --app-embed-width: auto;

      --forms-base-font-size: 14px;
      --forms-heading-font-size: 22px;

      --forms-body-font: normal 400 14px Arial, sans-serif;
      --forms-heading-font: normal 700 22px Arial, sans-serif;

      --forms-accent-color: #0C4F83;
