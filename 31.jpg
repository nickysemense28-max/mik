oupon-bundle-in-app":"<Amount/> <span1>coupon bundle in app</span1>","tax_disclaimer_without_threshold":"Temu will cover {{percent}}% of the import charges for the first {{orderCount}} orders within any {{numberOfDays}}-day period, up to {{maxAmount}} per order.","channel-goods-USER_NO_QA":"Only new App users can purchase products at affordable prices. You can still buy it at a discounted price.","max_coverage_amount":"{{amount}}","for_orders":"For orders","temu_covers":"Temu Covers","for_orders_over":"Over {{amount}}","max_coverage":"Max. Coverage","up_to_max_coverage":"Up to {{maxAmount}}","log_in_to_view_tax_coverage":"* Log in to view the applicable tax coverage.","leave_promotion":"Leave the promotion","of_import_charges":"of Import Charges","temu_covers_part_of_taxes":"Import charges may be covered by Temu","low_barrier_easy_to_start":"Easy to start","low_barrier_no_followers_needed":"No followers needed","for_orders_over_up_to":"For orders over {{minAmount}}, up to {{maxAmount}}","calendar_get":"Get","calendar_amount_label":"{{amount}}","calendar_with_qualified_order":"over the applicable claim period.","calendar_earn_value_gift":"Earn <span>{{amount}}</span> Value Gift","over_billion_download":"<span>Over {{num}} billion</span> downloads worldwide","price_after_coupon_new_eea":"<span>-{{amount}}</span> after coupon applied","claim_credits_coupons_free_gifts":"Claim credits,coupons & free gifts","for-invited-user":"For invited users","join-now":"Join now","join-and-earn":"Join,Share,Earn big","cash-bonus":"Cash Bonus","for-aff-new":"For New Affiliate gift","more-about-aff":"More details about Temu Affiliate Program","for-app-user":"For new app users","get_big":"GET","commission-off":"{{commission}}%","new-aff-gift":"New affiliate gift","sign-in-to-earn":"Sign in to Earn","extra-surprise":"Extra Shopping Surprises","commission":"Commission","shop_incredible_deals":"Shop incredible deals on Temu!","reward_to_you":"Reward to you","shop_like_a_billionaire":"Temu: