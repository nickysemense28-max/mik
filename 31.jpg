ept","SecureCertification":"Security certification","Download":{"appSeoUrl":"https://www.temu.com/app.html","AppStoreTitle":"App Store","AppStoreDesc":"Download on the","AppStoreImage":"https://aimg.kwcdn.com/upload_aimg/pc/5c5f0a0f-db6f-4205-a0d3-c745b6c672ea.png.slim.png","AppStoreHref":"https://apps.apple.com/us/app/temu-team-up-price-down/id1641486558","GooglePlayTitle":"Google Play","GooglePlayDesc":"Get it on","GooglePlayImage":"https://aimg.kwcdn.com/upload_aimg/pc/427c29ba-bef6-439c-9d4c-edbdde47c7e0.png.slim.png","GooglePlayHref":"https://play.google.com/store/apps/details?id=com.einnovation.temu","DownloadApp":"Download the Temu App"},"Media":{"Connect":"Connect with Temu","Instagram":"Instagram","Facebook":"Facebook","Twitter":"Twitter","Tiktok":"Tiktok","Youtube":"Youtube","Pinterest":"Pinterest"}}},"end_in":{"ends_in_countdown":"<span>Ends in</span><gap/><Countdown/>","day_txt":"d"},"affiliate_biz_common":{"channel-goods-limit-toast":"A new App user can only purchase one item with affordable price.","has-history-reward":"Sorry, you can’t claim the {{amountStr}} coupon bundle because you’ve already received a new-user offer.","channel-goods-nq-policy1":"1. One shopping cart can only add one item with the affordable price. If you want to switch, first delete the added one from the shopping cart.","returning_user_only":"Returning users only","channel-goods-download-title":"Download Temu app to shop with affordable price!","channel-goods-nq-title":"Affordable Price Unavailable","you_got_gift":"You've got a <span>welcome-back gift</span>","channel-goods-reason":"Only new app users can purchase products at affordable prices. But you can still buy it at a discounted price.","good_to_have_you_back":"Good to Have You Back!","channel-goods-CART_EXIST_GOODS":"One Shopping cart can only add one item with the affordable price. You can still add it at a discounted price.","channel-goods-NO_CHANNEL_PRICE":"Sorry, Items at affordable prices are sold out. You can still 