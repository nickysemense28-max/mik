it 😍.","name":"A***l","time":"Apr 11, 2023","picture":"https://aimg.kwcdn.com/upload_aimg/kuiper/de8e3ed3-7f84-4f9c-b6d0-2b688c6adf69.jpeg.slim.jpeg"},{"score":5,"goodsId":601099512950428,"comment":"Beautiful! I am so pleased with it!","name":"Monica Roussin","reviewTime":"yesterday","time":"Apr 25, 2023","picture":"https://aimg.kwcdn.com/upload_aimg/kuiper/3ccc39df-fc3d-4dbc-8c1f-b586c36cac69.jpeg.slim.jpeg"},{"score":5,"goodsId":601099513181420,"comment":"True to size and super light. Can walk in them all day!","name":"Estrella Perez","time":"Apr 11, 2023","picture":"https://aimg.kwcdn.com/upload_aimg/kuiper/42645f36-1eec-48e4-8341-5e8fbf5d1ad3.jpeg.slim.jpeg"},{"score":5,"goodsId":601099513409939,"comment":"They're cute asf. They're a lil loose on me but at the same time hug my thighs good. Also they’re easy to put on.","name":"gen2stunny","reviewTime":"yesterday","time":"Mar 11, 2023","picture":"https://aimg.kwcdn.com/upload_aimg/kuiper/e4d76f52-0ff0-4a1a-9f50-051101d12e28.jpeg.slim.jpeg"}],"common":{"rule_entry_t_c":"T&C","rule_dialog_terms_condition":"Terms & Conditions","this_item_was_discontinued":"This item was discontinued","item_details":"Item details are unavailable. Check out similar items.","close":"Close","detail":"Detail","comment_label":"{{score}} out of five stars","origin_price":"Original price","the_language_not_support":"The language you selected is not currently supported","the_currency_not_support":"The currency you selected is currently not supported","the_language_currency_not_support":"The language and currency you selected are not currently supported","spinning_wheel":"Spinning wheel","off_for_reduction_node":"OFF","rrp_upcase":"RRP","back":"back","appple_is_not_a_sponsor":"Apple is not a sponsor.","ok":"OK","RRP":"RRP","discontinued":"Discontinued","sold_out":"SOLD OUT","discount_details":"Discount Details","price_policy_title":"Price policy","ads_specific_tooltip":"Free shipping with no minimum order value on the advertised product(s).",