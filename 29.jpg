leusedcard2":"This card could not be saved for future transactions, please try to add another card."}},"web-transaction.web-add-to-order":{"openInNewTab":"Open in new tab.","close":"close","systemErrorTryLater":"System error. Please try again later.","PaymentFailed":"Payment failed. Please retry or use a different payment method.","payAgain":"One-click pay","OneClickPay":"One-Click Pay","Yes":"Yes","oneClickPayDefaultErrorMsg":"Failed to add items to order, please try again","successDialogDelayDesc":"The item(s) <1>will be charged to your </1> <0></0> before {{ hour }} on {{ date }}.","FailedToAdd":"Failed to add","successDialogTitle":"One-Click Pay successful","No":"No","Payment":"Payment","continueAdd":"Continue shopping","pay":"Pay","viewOrder":"View order","All":"All","Card":"Card","successDialogTip":"Newly added item(s) will ship with this order.","creditOutOfLimit":"You can only use {{max}} credits on this order","PleaseEnterValidNumber":"Please enter a valid number","credit":"Credit","UseCredit":"Use Credit","temuCredits":"Temu Credits","InputAmount":"Input amount","Apply":"Apply","introduceDialogTitle":"What is One-Click Pay","secureCheckout":"All data will be encrypted","Ok":"OK","composeDialogDesc":"The item(s) <2>has been paid with</2> <0></0> <2>and</2> <1></1>","OrderProcessErr":"We’re still processing your recent order. Most orders process within 72 hours, although they may occasionally take longer.","pickGiftAddToOrder":"Add free gift to this order","introduceDialogEntry":"What is One-Click Pay","pickFreeGift":"Pick a free gift","qualifyForGift":"Qualify for a free gift!","pickGiftSuccessAndShip":"Free gift picked successfully and ships with this order","paySuc":"Payment successful","addToCartRequest":"Would you like to add this item to your cart for later purchase?","addToCart":"Add to cart","payPro":"Payment processing ","payWith":"Pay with","freeGiftWillShip":"Eligible for the free gift! The free gift will ship with this order","pickGiftAndShip":"Qualify for a free gift! Pick a free gift to ship with this order","noSelectPaymentInfo":"Please select a payment method","continueShopLeftSeconds":"Continue shopping ({0}s)","cancel":"Cancel","creditDialogDesc":"<1>{{ amount }} has been deducted from your</1> <0></0>","MaxAvailable":"Max available","clearanceInformation":"Clearance information","successDialogDesc":"<1>{{ amount }} has been charged to your </1> <0></0> <1>account.</1>","pickFreeGiftShipContent":"Free gift will ship with this order.","pickFreeGiftTitle":"Pick a free gift to ship with this order","shipWithOrder":"One-click pay items ship with this order","introduceDialogText":"One-Click Pay is different from 'Add to cart'. <light>One-Click Pay allows you to add items to an order that has a status of 'Processing'.</light> These items are not added to your cart for later. <light>We will charge you for your One-Click Pay items before your order ships or within 13 hours of the original order being place.</light> So if the payment is not deducted immediately, please don't worry. We will notify you after the deduction is completed successfully. One-Click Pay items will be paid for and shipped the same way as the items in the original order. <br />The payment method (i.e. credit or debit card) used for your original order will be automatically used for One-Click Pay items. You can cancel your One-Click Pay items before they ship."},"web-address.main":{"noPickupPointsDesc":"Please contact the seller for assistance.","viewAllPickupPoints":"View all pickup points","openTargetBlank":"opens in a new tab, link.","pickupPoint":"Pickup point","copy":"Copy","mobile.tip":"Why","setDefault":"Set as default","use":"Use","copyFail":"Copy failed","copySuccess":"Copied successfully","choosePickupPoint":"Choose a pickup point","delete":"Delete","editBillingAddressTitle":"Edit billing address","default":"Default","noPickupPoints":"No available pickup points.","loading":"loading","addAddressTitle":"Add a new address","edit":"E